# Desktop Agent environment variables
# Copy this file to .env and fill in the values.

# ── Required ────────────────────────────────────────────────────────────────
# Must match SOFIA_AGENT_TOKEN set in your Render backend environment variables.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_TOKEN=your_secret_token_here

# ── Optional (defaults shown) ────────────────────────────────────────────────
# Render backend WebSocket URL
RENDER_BACKEND_WS_URL=wss://sofia-backend-csow.onrender.com/ws/agent

# Local Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (must support tool calling)
# Recommended: qwen2.5:7b-instruct  (fast, good tool calling)
# Alternative: qwen2.5:3b-instruct  (faster, lower RAM)
# Alternative: gemma3:9b            (Google model, good tool calling)
OLLAMA_MODEL=qwen2.5:7b-instruct
